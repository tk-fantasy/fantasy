# ===== 版本控制 =====
.git
.gitignore

# ===== Python 缓存与虚拟环境 =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# ===== Node =====
frontend/node_modules/
frontend/dist/

# ===== 前端构建产物（Dockerfile 多阶段构建会重新生成，排除已提交的过期副本）=====
app/static/frontend/

# ===== 运行时数据（由 volume 持久化，不进镜像）=====
logs/
*.log
app/data/aether.db
app/data/aether.db-shm
app/data/aether.db-wal
app/data/rag_index/
app/sg/output/

# ===== 密钥与本地配置（绝不进镜像）=====
.env
.env.local
config.json
config.json.bak
*.bak

# ===== 编辑器/系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== 非 app 运行时所需的内容（侧车容器/文档/测试/脚本）=====
# HA 与 MQTT 的配置由各自的侧车容器挂载，Aether 应用镜像不需要
ha_config/
mosquitto/
# 文档、代办、迁移脚本不属于运行时
# （docs/ 除外 —— RAG 服务需要读 docs/ 做知识库索引）
# integrations/ 保留：插件子进程 spawn 需要。tests/ 也保留（ Stage 3 test target 用，
# 生产 runtime stage 不再 COPY 进镜像）
todo/
# scripts/ 里仅入口脚本需进镜像（ENTRYPOINT 内置一份，compose 仍用宿主挂载
# 覆盖）；注意 Docker 规则：父目录被排除后无法用 ! 重新包含，故排除用 scripts/*
scripts/*
!scripts/entrypoint_tls.sh
# 示例文件保留 config.example.json（Dockerfile 需要），其余示例排除
.env.example
