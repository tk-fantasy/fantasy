# Aether 环境配置示例
# 复制本文件为 .env 并填入真实值。带「必填」的项影响核心功能，其余按需。

# ===== 认证（强烈建议设置） =====
# JWT 签名密钥：不设则每次启动随机生成（重启后所有登录会话失效）
JWT_SECRET=
# 接口访问令牌：API 直连鉴权（留空不启用）
APP_TOKEN=

# ===== Home Assistant（Docker 部署可留空，走 compose 的 HA_URL） =====
# HA 长期访问令牌（config.json ha.token_env 指向的变量名）
HA_TOKEN=

# ===== 摄像头 / 云台（密码不落 config.json，只存这里） =====
# 旧版单摄 RTSP 密码（多路摄像头的密码存在数据库，改用摄像头设置页配置）
RTSP_PASSWORD=
# 旧版 PTZ ONVIF 密码
PTZ_PASSWORD=

# ===== MQTT（虚拟设备，默认 aether/aether，改了需删 mosquitto/config/passwd 重启） =====
MQTT_USER=
MQTT_PASSWORD=

# ===== LLM API 密钥 =====
# 说明：通过前端 UI（模型管理/API Keys）添加的 key 会自动写入本文件，
# 形如 LLM_KEY_<ID>=sk-...，无需手动维护。以下为手工示例。
# ZHIPU_API_KEY_2=your_zhipu_api_key_here

# ===== 语音识别（可选） =====
SILICONFLOW_STT_KEY=

# ===== 集成插件（可选） =====
# 飞书机器人（integrations/feishu）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# ===== 语义图（可选） =====
KG_PIPELINE_PATH=
