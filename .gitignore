# 密钥与本地配置
.env
.env.local
config.json*
*.pre_*
*.bak
*.bak[0-9]*
app/data/.jwt_secret
mosquitto/config/passwd

# 运行时数据(含聊天记录、数据流状态、日志)
logs/
*.log

# Aether 运行时数据库（聊天记录、用户、会话等，每次运行都会变）
app/data/aether.db
app/data/aether.db-shm
app/data/aether.db-wal

# Emoji 向量索引（预构建，~119MB，过大不宜进版本库；需从现有机器拷贝）
app/data/emoji_index.json

# RAG 索引持久化产物（运行时构建，由 Docker volume 持久化）
app/data/rag_index/

# Home Assistant 运行时产物：日志、数据库、锁文件
ha_config/home-assistant.log
ha_config/home-assistant.log.*
ha_config/home-assistant_v2.db
ha_config/home-assistant_v2.db-shm
ha_config/home-assistant_v2.db-wal
ha_config/.ha_run.lock
ha_config/.simulator.lock
ha_config/secrets.yaml
# HA 运行时状态：IP 探测缓存
ha_config/.ha_ip_state

# HA 运行时安装的自定义组件（HACS 下载，如 xiaomi_home / xiaomi_gateway3 / hacs），勿进版本库
ha_config/custom_components/

# HA .storage — 全部忽略：均为 HA 实例绑定的运行时状态。
# 注意 core.config 也不跟踪：含家庭精确经纬度（隐私），且 onboarding 标记本就
# 不跟踪，新部署会走 HA 初始化向导重写该文件，模板无实际价值。
# 历史泄露处置见 docs/凭据轮换清单.md。
ha_config/.storage/*

# HA 品牌图标缓存（运行时下载，体积大）
ha_config/.cache/

# 一次性脚本（含用户名/环境信息）
import_keys.py

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# 虚拟环境
.venv/
venv/
env/

# Node
node_modules/
frontend/dist/
# 前端构建产物同步目录（npm run build → sync-to-backend.js 自动生成，勿进版本库）
app/static/frontend/

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db
.zcode/
.qwen/
# 浏览器调试产物（截图/会话状态，本地排障用）
.mimosa/

# 语义图构建产物（运行时生成）
app/sg/output/

# 编译产物 / 二进制（不入版本库）
*.exe
*.dll
*.pyd

# 运维页备份/升级历史（运行时产物）
backups/
